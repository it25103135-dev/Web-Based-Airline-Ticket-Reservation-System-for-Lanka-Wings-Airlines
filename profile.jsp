<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.lankawings.model.User,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Profile | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body class="app-page"><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container narrow page-pad"><div class="page-title"><span class="eyebrow navy">ACCOUNT SETTINGS</span><h1>Your profile</h1></div><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } %><% User u=(User)request.getAttribute("profile");if(u!=null){ %><div class="profile-grid"><section class="panel"><h2>Personal information</h2><form method="post"><input type="hidden" name="action" value="profile"><label>Full name<input name="fullName" required value="<%=HtmlUtil.esc(u.getFullName())%>"></label><label>Username<input disabled value="<%=HtmlUtil.esc(u.getUsername())%>"></label><label>Email<input name="email" type="email" required value="<%=HtmlUtil.esc(u.getEmail())%>"></label><label>Phone<input name="phone" value="<%=HtmlUtil.esc(u.getPhone())%>"></label><button class="btn btn-orange">Save Profile</button></form></section><section class="panel"><h2>Reset password</h2><form method="post"><input type="hidden" name="action" value="password"><label>New password<input type="password" name="newPassword" minlength="6" required></label><button class="btn btn-navy">Update Password</button></form><div class="role-chip">Role: <b><%=HtmlUtil.esc(u.getRole())%></b></div></section></div><% } %></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
