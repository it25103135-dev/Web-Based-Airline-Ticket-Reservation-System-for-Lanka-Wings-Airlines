<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.lankawings.model.Notification,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body class="app-page"><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container narrow page-pad"><div class="panel-head"><div class="page-title"><span class="eyebrow navy">TRAVEL UPDATES</span><h1>Notifications</h1></div><a class="btn btn-outline small" href="?read=1">Mark all read</a></div><div class="notification-list"><% List<Notification> ns=(List<Notification>)request.getAttribute("notifications");if(ns!=null&&!ns.isEmpty()){for(Notification n:ns){ %><div class="notification <%=n.isRead()?"read":""%>"><div class="note-icon">✈</div><div><div class="notification-title"><strong><%=HtmlUtil.esc(n.getTitle())%></strong><span><%=n.getCreatedAt()%></span></div><p><%=HtmlUtil.esc(n.getMessage())%></p></div></div><% }}else{ %><div class="empty-state">No notifications yet.</div><% } %></div></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
