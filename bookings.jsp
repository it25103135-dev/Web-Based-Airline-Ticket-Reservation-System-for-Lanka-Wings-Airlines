<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.text.SimpleDateFormat,com.lankawings.model.Booking,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Bookings | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">PASSENGER</span><h1>Booking history & management</h1><p>Search using your Passport / ID to view booking history, or use a PNR to open one booking.</p></div>
<div class="search-grid"><form class="search-panel" method="get"><label>Passport / ID<input name="passportNo" value="<%=HtmlUtil.esc(request.getParameter("passportNo"))%>" placeholder="e.g. N1234567" required></label><button class="btn btn-orange">View Booking History</button></form><form class="search-panel" method="get"><label>PNR<input name="pnr" value="<%=HtmlUtil.esc(request.getParameter("pnr"))%>" placeholder="e.g. LWBM1001" required></label><button class="btn btn-navy">Open Booking</button></form></div>
<% if(request.getParameter("ok")!=null){ %><div class="alert success">Booking updated successfully.</div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% }
List<Booking> bs=(List<Booking>)request.getAttribute("bookings"); Booking single=(Booking)request.getAttribute("singleBooking"); if(single!=null){bs=new ArrayList<>();bs.add(single);} SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm"); String backPassport=(String)request.getAttribute("searchedPassport"); if(bs!=null){ if(bs.isEmpty()){ %><div class="empty-state"><h3>No bookings found</h3><p>No booking records match that Passport / ID.</p></div><% } else { %><div class="booking-cards"><% for(Booking b:bs){ %><article class="booking-card"><div class="booking-top"><div><span class="eyebrow navy">PNR</span><h3><%=HtmlUtil.esc(b.getPnr())%></h3></div><span class="badge <%= "CANCELLED".equals(b.getBookingStatus())?"bad":"good" %>"><%=HtmlUtil.esc(b.getBookingStatus())%></span></div><div class="booking-route"><strong><%=HtmlUtil.esc(b.getOrigin())%></strong><span>— ✈ —</span><strong><%=HtmlUtil.esc(b.getDestination())%></strong></div><div class="booking-info"><span><small>Flight</small><b><%=HtmlUtil.esc(b.getFlightNo())%></b></span><span><small>Departure</small><b><%=df.format(b.getDepartureTime())%></b></span><span><small>Seat</small><b><%=HtmlUtil.esc(b.getSeatNumber())%></b></span><span><small>Passenger</small><b><%=HtmlUtil.esc(b.getPassengerName())%></b></span><span><small>Passport / ID</small><b><%=HtmlUtil.esc(b.getPassportNo())%></b></span><span><small>Booked</small><b><%=df.format(b.getBookedAt())%></b></span></div>
<% if(!"CANCELLED".equals(b.getBookingStatus())){ %><details><summary>Modify reservation / passenger details</summary><form method="post" class="inline-form"><input type="hidden" name="id" value="<%=b.getBookingId()%>"><input type="hidden" name="action" value="update"><input type="hidden" name="backPassport" value="<%=HtmlUtil.esc(backPassport)%>"><input type="hidden" name="backPnr" value="<%=HtmlUtil.esc(b.getPnr())%>"><label>Passenger name<input name="passengerName" value="<%=HtmlUtil.esc(b.getPassengerName())%>" required></label><label>Passport / ID<input name="passportNo" value="<%=HtmlUtil.esc(b.getPassportNo())%>" required></label><label>Seat<input name="seatNumber" value="<%=HtmlUtil.esc(b.getSeatNumber())%>" required></label><button class="btn btn-navy small">Save Changes</button></form></details><% } %>
<div class="booking-actions"><a class="btn btn-outline small" href="<%=cp%>/ticket?bookingId=<%=b.getBookingId()%>">Generate E-Ticket</a><a class="btn btn-outline small" href="<%=cp%>/ticket/download?bookingId=<%=b.getBookingId()%>">Download E-Ticket</a><% if(!"CANCELLED".equals(b.getBookingStatus())){ %><form method="post" onsubmit="return confirm('Cancel this booking?')"><input type="hidden" name="id" value="<%=b.getBookingId()%>"><input type="hidden" name="action" value="cancel"><input type="hidden" name="backPassport" value="<%=HtmlUtil.esc(backPassport)%>"><input type="hidden" name="backPnr" value="<%=HtmlUtil.esc(b.getPnr())%>"><button class="btn btn-danger small">Cancel Booking</button></form><% } %></div></article><% } %></div><% }} %></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
