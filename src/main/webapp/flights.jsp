<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.text.SimpleDateFormat,com.lankawings.model.Flight,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reserve a Flight | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body class="app-page"><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title reveal"><span class="eyebrow navy">TICKET RESERVATION</span><h1>Find your flight</h1></div><form class="search-panel reveal" method="get"><label>From<input name="origin" value="<%=HtmlUtil.esc(request.getParameter("origin"))%>" placeholder="Colombo"></label><label>To<input name="destination" value="<%=HtmlUtil.esc(request.getParameter("destination"))%>" placeholder="Dubai"></label><label>Date<input type="date" name="date" value="<%=HtmlUtil.esc(request.getParameter("date"))%>"></label><button class="btn btn-orange" type="submit">Search Flights</button></form><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } %><div class="flight-list"><% List<Flight> fs=(List<Flight>)request.getAttribute("flights");SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm");if(fs!=null&&!fs.isEmpty()){for(Flight f:fs){ %><article class="flight-card reveal"><div class="flight-no"><span><%=HtmlUtil.esc(f.getFlightNo())%></span><small><%=HtmlUtil.esc(f.getAircraft())%></small></div><div class="route"><div><strong><%=HtmlUtil.esc(f.getOrigin())%></strong><small><%=df.format(f.getDepartureTime())%></small></div><div class="route-line"><span>✈</span></div><div><strong><%=HtmlUtil.esc(f.getDestination())%></strong><small><%=df.format(f.getArrivalTime())%></small></div></div><div class="flight-meta"><span class="badge"><%=f.getStatus()%></span><span><b><%=f.getAvailableSeats()%></b> seats left</span></div><div class="price"><small>Fare</small><strong>LKR <%=String.format("%,.2f",f.getFare())%></strong><% if(f.getAvailableSeats()>0){ %><a class="btn btn-navy small" href="<%=cp%>/reserve?flightId=<%=f.getFlightId()%>">Select Flight</a><% } %></div></article><% }}else{ %><div class="empty-state reveal"><div>✈</div><h3>No matching flights</h3><p>Try another route or departure date.</p></div><% } %></div></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
