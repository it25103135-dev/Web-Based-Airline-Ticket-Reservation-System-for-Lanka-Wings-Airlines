<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.lankawings.model.Review" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Reviews | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">MY REVIEWS</span><h1>Manage submitted feedback</h1><p>Use the same email address and booking reference that you used when submitting the review.</p></div><form class="search-panel" method="get"><label>Email<input type="email" name="email" required value="<%=HtmlUtil.esc(request.getParameter("email"))%>" placeholder="name@example.com"></label><label>Booking reference<input name="bookingReference" required value="<%=HtmlUtil.esc(request.getParameter("bookingReference"))%>" placeholder="LW-ABC-1234"></label><button class="btn btn-navy">Find Reviews</button></form><% if(request.getParameter("ok")!=null){ %><div class="alert success">Your review was updated successfully.</div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } List<Review> reviews=(List<Review>)request.getAttribute("reviews"); if(reviews!=null){ if(reviews.isEmpty()){ %><div class="empty-state">No reviews matched those passenger details.</div><% } else { %><div class="review-list"><% for(Review r:reviews){ %><article class="review-card"><div class="review-head"><div><b><%=HtmlUtil.esc(r.getTitle())%></b><span class="stars"><%=r.getRating()%>/5 ★</span></div><span class="badge <%= "PUBLISHED".equals(r.getStatus())?"good":"warn" %>"><%=HtmlUtil.esc(r.getStatus())%></span></div><small><%=HtmlUtil.esc(r.getBookingReference())%><% if(r.getFlightNo()!=null){ %> • <%=HtmlUtil.esc(r.getFlightNo())%><% } %></small><p><%=HtmlUtil.esc(r.getComment())%></p><% if(r.getAdminResponse()!=null){ %><div class="admin-reply"><strong>Lanka Wings response</strong><p><%=HtmlUtil.esc(r.getAdminResponse())%></p></div><% } %><details><summary>Edit review</summary><form class="edit-review-form" method="post"><input type="hidden" name="reviewId" value="<%=r.getReviewId()%>"><input type="hidden" name="email" value="<%=HtmlUtil.esc(request.getParameter("email"))%>"><input type="hidden" name="bookingReference" value="<%=HtmlUtil.esc(request.getParameter("bookingReference"))%>"><label>Rating<select name="rating"><% for(int i=5;i>=1;i--){ %><option value="<%=i%>" <%=r.getRating()==i?"selected":""%>><%=i%></option><% } %></select></label><label>Title<input name="title" value="<%=HtmlUtil.esc(r.getTitle())%>" required maxlength="150"></label><label>Comment<textarea name="comment" rows="4" required maxlength="1500"><%=HtmlUtil.esc(r.getComment())%></textarea></label><div class="action-row"><button class="btn btn-navy small" name="action" value="update">Save changes</button><button class="btn btn-danger small" name="action" value="delete" onclick="return confirm('Delete this review permanently?')">Delete</button></div></form></details></article><% } %></div><% }} %></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
