<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.lankawings.model.Payment,com.lankawings.model.PaymentOrder,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Transaction History | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">TRANSACTION LOG</span><h1>Payment history</h1><p>Search using the booking reference to view all payment attempts and their current statuses.</p></div><div class="lookup-box panel"><form method="get"><input name="ref" required placeholder="Booking reference" value="<%=request.getParameter("ref")==null?"":HtmlUtil.esc(request.getParameter("ref"))%>"><button class="btn btn-navy">Search</button></form></div><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } PaymentOrder o=(PaymentOrder)request.getAttribute("order"); List<Payment> payments=(List<Payment>)request.getAttribute("payments"); if(o!=null){ %><div class="booking-card"><div class="booking-top"><div><span class="eyebrow">BOOKING</span><h3><%=HtmlUtil.esc(o.getBookingReference())%></h3></div><span class="badge <%= "PAID".equals(o.getOrderStatus())?"good":"" %>"><%=HtmlUtil.esc(o.getOrderStatus())%></span></div><div class="booking-info"><span><small>Passenger</small><b><%=HtmlUtil.esc(o.getPassengerName())%></b></span><span><small>Route</small><b><%=HtmlUtil.esc(o.getRouteSummary())%></b></span><span><small>Amount</small><b>LKR <%=String.format("%,.2f",o.getAmount())%></b></span></div></div><div class="table-wrap"><table><thead><tr><th>Transaction</th><th>Date</th><th>Method</th><th>Card</th><th>Amount</th><th>Status</th><th>Receipt</th></tr></thead><tbody><% if(payments!=null && !payments.isEmpty()){ for(Payment p:payments){ %><tr><td><b><%=HtmlUtil.esc(p.getTransactionRef())%></b></td><td><%=p.getPaidAt()%></td><td><%=HtmlUtil.esc(p.getMethod())%></td><td>•••• <%=HtmlUtil.esc(p.getCardLast4())%></td><td>LKR <%=String.format("%,.2f",p.getAmount())%></td><td><span class="status-<%=p.getGatewayStatus().toLowerCase()%>"><%=HtmlUtil.esc(p.getGatewayStatus())%></span><% if(p.getFailureReason()!=null){ %><br><small><%=HtmlUtil.esc(p.getFailureReason())%></small><% } %></td><td><% if("SUCCESS".equals(p.getGatewayStatus())){ %><a class="btn btn-outline small" href="<%=request.getContextPath()%>/receipt?tx=<%=p.getTransactionRef()%>">Receipt</a><% } else { %>—<% } %></td></tr><% }} else { %><tr><td colspan="7">No transactions recorded for this booking.</td></tr><% } %></tbody></table></div><% } %></main><%@ include file="WEB-INF/jspf/footer.jspf" %><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
