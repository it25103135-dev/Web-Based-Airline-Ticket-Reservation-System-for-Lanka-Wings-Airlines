<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.lankawings.model.PaymentOrder,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Make Payment | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">SECURE CHECKOUT</span><h1>Online payment</h1><p>Enter a booking reference to load the amount due, then authorize the card transaction.</p></div><div class="lookup-box panel"><form method="get"><input name="ref" required placeholder="Booking reference, e.g. LW-PAY-1001" value="<%=request.getParameter("ref")==null?"":HtmlUtil.esc(request.getParameter("ref"))%>"><button class="btn btn-navy">Find booking</button></form><p class="helper">Test references: LW-PAY-1001, LW-PAY-1002, LW-PAY-1003</p></div><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } PaymentOrder o=(PaymentOrder)request.getAttribute("order"); if(o!=null){ %><div class="payment-shell"><section class="panel"><div class="secure-note">🔒 Classroom gateway simulation. The full card number and CVV are used only for authorization validation and are never stored. Only the final four card digits are saved.</div><% if("PAID".equals(o.getOrderStatus())){ %><div class="alert success">This booking is already paid. Use Transaction History to open the receipt.</div><% } else if("CANCELLED".equals(o.getOrderStatus())){ %><div class="alert error">This booking has been cancelled and cannot be paid.</div><% } else { %><form method="post"><input type="hidden" name="orderId" value="<%=o.getOrderId()%>"><label>Payment method<select name="method" required><option value="Visa">Visa</option><option value="Mastercard">Mastercard</option><option value="Debit Card">Debit Card</option></select></label><label>Cardholder name<input name="cardholder" required placeholder="Name on card"></label><label>Card number<input name="cardNumber" required inputmode="numeric" autocomplete="cc-number" maxlength="23" placeholder="4242 4242 4242 4242"></label><div class="form-grid"><label>Expiry<input name="expiry" required autocomplete="cc-exp" placeholder="MM/YY"></label><label>CVV<input name="cvv" type="password" required inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="123"></label></div><button class="btn btn-orange">Pay LKR <%=String.format("%,.2f",o.getAmount())%></button></form><p class="helper">For testing: 4242 4242 4242 4242, any future MM/YY, CVV 123.</p><% } %></section><aside class="summary-card"><span class="eyebrow">PAYMENT SUMMARY</span><h2><%=HtmlUtil.esc(o.getBookingReference())%></h2><div class="summary-line"><span>Passenger</span><b><%=HtmlUtil.esc(o.getPassengerName())%></b></div><div class="summary-line"><span>Route</span><b><%=HtmlUtil.esc(o.getRouteSummary())%></b></div><div class="summary-line"><span>Order status</span><b><%=HtmlUtil.esc(o.getOrderStatus())%></b></div><div class="summary-line total"><span>Total</span><b>LKR <%=String.format("%,.2f",o.getAmount())%></b></div></aside></div><% } %></main><%@ include file="WEB-INF/jspf/footer.jspf" %><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
