<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.lankawings.model.Flight,com.lankawings.util.HtmlUtil,java.text.SimpleDateFormat,java.util.Set" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Select Seat | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body class="app-page"><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container narrow page-pad"><% Flight f=(Flight)request.getAttribute("flight");if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } %><% if(f!=null){SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm");Set<String> used=(Set<String>)request.getAttribute("bookedSeats"); %><div class="page-title"><span class="eyebrow navy">TICKET RESERVATION</span><h1>Select your seat</h1></div><div class="booking-layout"><section class="panel"><h2>Passenger details</h2><form method="post"><input type="hidden" name="flightId" value="<%=f.getFlightId()%>"><label>Passenger full name<input name="passengerName" required></label><label>Passport / ID number<input name="passportNo" required placeholder="e.g. N1234567"></label><label>Seat number<select name="seatNumber" required><option value="">Choose a seat</option><% int rows=(int)Math.ceil(f.getTotalSeats()/6.0);int seatIndex=0;for(int row=1;row<=rows;row++){for(char c:new char[]{'A','B','C','D','E','F'}){seatIndex++;if(seatIndex>f.getTotalSeats())break;String seat=""+row+c;if(used==null||!used.contains(seat)){ %><option value="<%=seat%>"><%=seat%></option><% }}} %></select></label><button class="btn btn-orange full" type="submit">Confirm Reservation</button></form></section><aside class="trip-summary"><span class="eyebrow">YOUR FLIGHT</span><h2><%=HtmlUtil.esc(f.getFlightNo())%></h2><div class="summary-route"><strong><%=HtmlUtil.esc(f.getOrigin())%></strong><span>✈</span><strong><%=HtmlUtil.esc(f.getDestination())%></strong></div><p><%=df.format(f.getDepartureTime())%></p><hr><div class="summary-line"><span>Aircraft</span><b><%=HtmlUtil.esc(f.getAircraft())%></b></div><div class="summary-line"><span>Available seats</span><b><%=f.getAvailableSeats()%></b></div><div class="summary-line total"><span>Fare</span><b>LKR <%=String.format("%,.2f",f.getFare())%></b></div></aside></div><% } %></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
