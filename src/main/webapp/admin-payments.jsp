<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.lankawings.model.Payment,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Financial Manager | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">FINANCIAL MANAGER</span><h1>Payment audit & transaction management</h1><p>Review all payment records, monitor gateway status, flag discrepancies for auditing, resolve flags, and update paid orders through refunds.</p></div><% String adminError=(String)session.getAttribute("adminError"); if(adminError!=null){ session.removeAttribute("adminError"); %><div class="alert error"><%=HtmlUtil.esc(adminError)%></div><% } %><div class="table-wrap"><table><thead><tr><th>Transaction</th><th>Booking / Passenger</th><th>Amount</th><th>Method</th><th>Status</th><th>Audit</th><th>Actions</th></tr></thead><tbody><% List<Payment> list=(List<Payment>)request.getAttribute("payments"); if(list!=null && !list.isEmpty()){ for(Payment p:list){ %><tr><td><b><%=HtmlUtil.esc(p.getTransactionRef())%></b><br><small><%=p.getPaidAt()%></small></td><td><b><%=HtmlUtil.esc(p.getBookingReference())%></b><br><small><%=HtmlUtil.esc(p.getPassengerName())%></small></td><td>LKR <%=String.format("%,.2f",p.getAmount())%></td><td><%=HtmlUtil.esc(p.getMethod())%><br><small>•••• <%=HtmlUtil.esc(p.getCardLast4())%></small></td><td><span class="status-<%=p.getGatewayStatus().toLowerCase()%>"><%=HtmlUtil.esc(p.getGatewayStatus())%></span><% if(p.getFailureReason()!=null){ %><br><small><%=HtmlUtil.esc(p.getFailureReason())%></small><% } %></td><td><% if(p.isFlagged()){ %><span class="audit-open"><%=HtmlUtil.esc(p.getAuditStatus())%></span><br><small><%=HtmlUtil.esc(p.getAuditIssue())%></small><% } else { %>No flag<% } %></td><td><form class="audit-form" method="post"><input type="hidden" name="paymentId" value="<%=p.getPaymentId()%>"><input name="issue" placeholder="Discrepancy / audit note"><button class="btn btn-outline small" name="action" value="flag">Flag</button></form><div class="mini-actions"><% if(p.isFlagged() && "OPEN".equals(p.getAuditStatus())){ %><form method="post"><input type="hidden" name="paymentId" value="<%=p.getPaymentId()%>"><button class="btn btn-navy small" name="action" value="resolve">Resolve flag</button></form><% } if("SUCCESS".equals(p.getGatewayStatus())){ %><form method="post" onsubmit="return confirm('Refund this successful transaction?');"><input type="hidden" name="paymentId" value="<%=p.getPaymentId()%>"><button class="btn btn-danger small" name="action" value="refund">Refund</button></form><% } %></div></td></tr><% }} else { %><tr><td colspan="7">No transactions have been recorded yet.</td></tr><% } %></tbody></table></div></main><%@ include file="WEB-INF/jspf/footer.jspf" %><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
