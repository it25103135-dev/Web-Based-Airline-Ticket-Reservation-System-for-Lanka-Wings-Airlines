<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.Set,java.text.SimpleDateFormat,com.lankawings.model.Booking,com.lankawings.model.Flight,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reservation Status | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body class="app-page"><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container narrow page-pad"><div class="page-title"><span class="eyebrow navy">RESERVATION STATUS</span><h1>Manage your reservation</h1></div><form class="search-panel" method="get"><label>PNR<input name="pnr" value="<%=HtmlUtil.esc(request.getParameter("pnr"))%>" placeholder="e.g. LW12AB34CD" required></label><button class="btn btn-orange" type="submit">Check Status</button></form><% if(request.getParameter("ok")!=null){ %><div class="alert success">Reservation updated successfully.</div><% } %><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } Booking b=(Booking)request.getAttribute("booking");if(b!=null){SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm"); %><article class="booking-card reveal"><div class="booking-top"><div><span class="eyebrow navy">PNR</span><h3><%=HtmlUtil.esc(b.getPnr())%></h3></div><span class="badge"><%=b.getBookingStatus()%></span></div><div class="booking-route"><strong><%=HtmlUtil.esc(b.getOrigin())%></strong><span>— ✈ —</span><strong><%=HtmlUtil.esc(b.getDestination())%></strong></div><div class="booking-info"><span><small>Flight</small><b><%=HtmlUtil.esc(b.getFlightNo())%></b></span><span><small>Departure</small><b><%=df.format(b.getDepartureTime())%></b></span><span><small>Seat</small><b><%=HtmlUtil.esc(b.getSeatNumber())%></b></span><span><small>Passenger</small><b><%=HtmlUtil.esc(b.getPassengerName())%></b></span></div><% if(!"CANCELLED".equals(b.getBookingStatus())){Set<String> used=(Set<String>)request.getAttribute("bookedSeats"); %><details><summary>Modify reservation details / change seat</summary><form method="post" class="inline-form"><input type="hidden" name="id" value="<%=b.getBookingId()%>"><input type="hidden" name="pnr" value="<%=HtmlUtil.esc(b.getPnr())%>"><input type="hidden" name="action" value="update"><label>Name<input name="passengerName" value="<%=HtmlUtil.esc(b.getPassengerName())%>" required></label><label>Passport / ID<input name="passportNo" value="<%=HtmlUtil.esc(b.getPassportNo())%>" required></label><label>Seat<select name="seatNumber" required><% Flight f=(Flight)request.getAttribute("flight");int rows=(int)Math.ceil(f.getTotalSeats()/6.0);int seatIndex=0;for(int row=1;row<=rows;row++){for(char c:new char[]{'A','B','C','D','E','F'}){seatIndex++;if(seatIndex>f.getTotalSeats())break;String seat=""+row+c;if(seat.equals(b.getSeatNumber())||used==null||!used.contains(seat)){ %><option value="<%=seat%>" <%=seat.equals(b.getSeatNumber())?"selected":""%>><%=seat%></option><% }}} %></select></label><button class="btn btn-navy small">Save Changes</button></form></details><div class="booking-actions"><a class="btn btn-outline small" href="<%=cp%>/ticket?pnr=<%=java.net.URLEncoder.encode(b.getPnr(),java.nio.charset.StandardCharsets.UTF_8)%>">E-Ticket</a><form method="post" onsubmit="return confirm('Cancel this reservation?')"><input type="hidden" name="id" value="<%=b.getBookingId()%>"><input type="hidden" name="pnr" value="<%=HtmlUtil.esc(b.getPnr())%>"><input type="hidden" name="action" value="cancel"><button class="btn btn-danger small">Cancel Reservation</button></form></div><% }else{ %><div class="booking-actions"><a class="btn btn-outline small" href="<%=cp%>/ticket?pnr=<%=java.net.URLEncoder.encode(b.getPnr(),java.nio.charset.StandardCharsets.UTF_8)%>">View E-Ticket</a></div><% } %></article><% } %></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
