<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.text.SimpleDateFormat,com.lankawings.model.Review" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Feedback Management | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">ADMINISTRATOR</span><h1>Feedback & review management</h1><p>View all passenger feedback, respond to reviews, control public visibility, and remove inappropriate records.</p></div><% String msg=(String)session.getAttribute("adminMessage"); String err=(String)session.getAttribute("adminError"); if(msg!=null){session.removeAttribute("adminMessage");%><div class="alert success"><%=HtmlUtil.esc(msg)%></div><%} if(err!=null){session.removeAttribute("adminError");%><div class="alert error"><%=HtmlUtil.esc(err)%></div><%} if(request.getAttribute("error")!=null){%><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><%} List<Review> reviews=(List<Review>)request.getAttribute("reviews"); SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm"); int total=reviews==null?0:reviews.size(), responses=0, published=0; double sum=0; if(reviews!=null){for(Review r:reviews){sum+=r.getRating();if(r.getAdminResponse()!=null&&!r.getAdminResponse().isBlank())responses++;if("PUBLISHED".equals(r.getStatus()))published++;}} %><div class="stats-grid"><div class="stat-card"><span>Total reviews</span><strong><%=total%></strong><small>All passenger feedback</small></div><div class="stat-card"><span>Average rating</span><strong><%=total==0?"0.0":String.format("%.1f",sum/total)%></strong><small>Out of 5 stars</small></div><div class="stat-card"><span>Responded</span><strong><%=responses%></strong><small><%=published%> currently published</small></div></div><div class="review-list"><% if(reviews!=null&&!reviews.isEmpty()){for(Review r:reviews){%><article class="review-card"><div class="review-head"><div><b><%=HtmlUtil.esc(r.getPassengerName())%></b><span class="stars"><%=r.getRating()%>/5 ★</span></div><span class="badge <%= "PUBLISHED".equals(r.getStatus())?"good":"warn" %>"><%=HtmlUtil.esc(r.getStatus())%></span></div><small><%=HtmlUtil.esc(r.getEmail())%> • <%=HtmlUtil.esc(r.getBookingReference())%><% if(r.getFlightNo()!=null){%> • <%=HtmlUtil.esc(r.getFlightNo())%><%}%> • <%=df.format(r.getCreatedAt())%></small><h3><%=HtmlUtil.esc(r.getTitle())%></h3><p><%=HtmlUtil.esc(r.getComment())%></p><% if(r.getAdminResponse()!=null&&!r.getAdminResponse().isBlank()){%><div class="admin-reply"><strong>Current response</strong><p><%=HtmlUtil.esc(r.getAdminResponse())%></p></div><%}%><form class="response-form" method="post"><input type="hidden" name="reviewId" value="<%=r.getReviewId()%>"><textarea name="response" rows="2" placeholder="Write an administrator response..."><%=HtmlUtil.esc(r.getAdminResponse())%></textarea><button class="btn btn-navy small" name="action" value="respond">Save response</button></form><div class="action-row"><form method="post"><input type="hidden" name="reviewId" value="<%=r.getReviewId()%>"><% if("PUBLISHED".equals(r.getStatus())){%><button class="btn btn-outline small" name="action" value="hide">Hide review</button><%}else{%><button class="btn btn-outline small" name="action" value="publish">Publish review</button><%}%></form><form method="post" onsubmit="return confirm('Delete this feedback record permanently?')"><input type="hidden" name="reviewId" value="<%=r.getReviewId()%>"><button class="btn btn-danger small" name="action" value="delete">Delete</button></form></div></article><%}}else{%><div class="empty-state">No feedback records found.</div><%}%></div></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
