<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.lankawings.model.Payment,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Payment Receipt | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } Payment p=(Payment)request.getAttribute("payment"); if(p!=null){ %><section class="receipt-card"><div class="receipt-head"><div><span class="eyebrow">PAYMENT RECEIPT</span><h2>Lanka Wings</h2><p class="helper"><%=HtmlUtil.esc(p.getTransactionRef())%></p></div><div class="receipt-amount">LKR <%=String.format("%,.2f",p.getAmount())%></div></div><div class="receipt-grid"><div><small>Booking reference</small><b><%=HtmlUtil.esc(p.getBookingReference())%></b></div><div><small>Passenger</small><b><%=HtmlUtil.esc(p.getPassengerName())%></b></div><div><small>Payment method</small><b><%=HtmlUtil.esc(p.getMethod())%> •••• <%=HtmlUtil.esc(p.getCardLast4())%></b></div><div><small>Paid at</small><b><%=p.getPaidAt()%></b></div><div><small>Transaction reference</small><b><%=HtmlUtil.esc(p.getTransactionRef())%></b></div><div><small>Status</small><b><%=HtmlUtil.esc(p.getGatewayStatus())%></b></div></div><% if("SUCCESS".equals(p.getGatewayStatus())){ %><div class="receipt-ok">✓ Payment authorized successfully. Order status updated to PAID.</div><div class="print-row"><a class="btn btn-navy" href="<%=request.getContextPath()%>/receipt/download?tx=<%=p.getTransactionRef()%>">Download Receipt</a><button class="btn btn-outline" onclick="window.print()">Print</button></div><% } else { %><div class="alert error">This transaction was not successful.</div><% } %></section><% } %></main><%@ include file="WEB-INF/jspf/footer.jspf" %><script src="<%=request.getContextPath()%>/assets/js/app.js"></script></body></html>
