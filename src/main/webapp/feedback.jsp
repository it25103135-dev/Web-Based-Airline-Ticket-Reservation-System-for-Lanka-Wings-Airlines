<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.text.SimpleDateFormat,com.lankawings.model.Review" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Passenger Feedback | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">FEEDBACK & REVIEWS</span><h1>Tell us about your journey</h1><p>Submit a rating and written review. Published feedback and administrator responses are shown below.</p></div><% if(request.getParameter("submitted")!=null){ %><div class="alert success">Thank you. Your feedback was submitted successfully.</div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } %><section class="panel"><h2>Write a review</h2><form method="post" action="<%=request.getContextPath()%>/feedback"><div class="form-grid"><label>Passenger name<input name="passengerName" required maxlength="120" placeholder="Full name"></label><label>Email<input type="email" name="email" required maxlength="150" placeholder="name@example.com"></label><label>Booking reference<input name="bookingReference" required maxlength="30" placeholder="LW-ABC-1234"></label><label>Flight number<input name="flightNo" maxlength="20" placeholder="LW101"></label><label>Rating<select name="rating" required><option value="">Select rating</option><option value="5">5 - Excellent</option><option value="4">4 - Very good</option><option value="3">3 - Good</option><option value="2">2 - Fair</option><option value="1">1 - Poor</option></select></label><label>Review title<input name="title" required maxlength="150" placeholder="Short title"></label></div><label>Comments<textarea name="comment" rows="5" required maxlength="1500" placeholder="Tell us about your experience..."></textarea></label><button class="btn btn-orange" type="submit">Submit Feedback</button></form></section><section><div class="panel-head"><div><span class="eyebrow navy">PASSENGER REVIEWS</span><h2>Recent feedback</h2></div></div><div class="review-list"><% List<Review> reviews=(List<Review>)request.getAttribute("reviews"); SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm"); if(reviews!=null&&!reviews.isEmpty()){ for(Review r:reviews){ String stars="★★★★★".substring(0,r.getRating())+"☆☆☆☆☆".substring(0,5-r.getRating()); %><article class="review-card"><div class="review-head"><div><b><%=HtmlUtil.esc(r.getPassengerName())%></b><span class="stars"><%=stars%></span></div><span class="badge good"><%=r.getRating()%>/5</span></div><small><%=HtmlUtil.esc(r.getBookingReference())%><% if(r.getFlightNo()!=null){ %> • <%=HtmlUtil.esc(r.getFlightNo())%><% } %> • <%=df.format(r.getCreatedAt())%></small><h3><%=HtmlUtil.esc(r.getTitle())%></h3><p><%=HtmlUtil.esc(r.getComment())%></p><% if(r.getAdminResponse()!=null&&!r.getAdminResponse().isBlank()){ %><div class="admin-reply"><strong>Lanka Wings response</strong><p><%=HtmlUtil.esc(r.getAdminResponse())%></p></div><% } %></article><% }} else { %><div class="empty-state">No published reviews yet.</div><% } %></div></section></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
