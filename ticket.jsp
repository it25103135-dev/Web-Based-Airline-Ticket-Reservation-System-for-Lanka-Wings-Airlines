<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.lankawings.model.Booking,com.lankawings.util.HtmlUtil,java.text.SimpleDateFormat" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>E-Ticket | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container narrow page-pad"><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } Booking b=(Booking)request.getAttribute("booking");if(b!=null){SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm"); %><div class="ticket"><div class="ticket-head"><div class="brand light"><span class="brand-mark">LW</span><span>Lanka <b>Wings</b></span></div><span>ELECTRONIC TICKET</span></div><div class="ticket-body"><div class="ticket-route"><div><small>FROM</small><strong><%=HtmlUtil.esc(b.getOrigin())%></strong></div><span>✈</span><div><small>TO</small><strong><%=HtmlUtil.esc(b.getDestination())%></strong></div></div><div class="ticket-grid"><span><small>Passenger</small><b><%=HtmlUtil.esc(b.getPassengerName())%></b></span><span><small>Flight</small><b><%=HtmlUtil.esc(b.getFlightNo())%></b></span><span><small>Departure</small><b><%=df.format(b.getDepartureTime())%></b></span><span><small>Seat</small><b><%=HtmlUtil.esc(b.getSeatNumber())%></b></span><span><small>PNR</small><b><%=HtmlUtil.esc(b.getPnr())%></b></span><span><small>Status</small><b><%=HtmlUtil.esc(b.getBookingStatus())%></b></span></div><div class="barcode">|||| || | |||| ||| | || ||||| || ||| |||| |</div></div></div><div class="print-row"><button class="btn btn-orange" onclick="window.print()">Print / Save E-Ticket</button><a class="btn btn-navy" href="<%=cp%>/ticket/download?bookingId=<%=b.getBookingId()%>">Download E-Ticket</a><a class="btn btn-outline" href="<%=cp%>/bookings?pnr=<%=java.net.URLEncoder.encode(b.getPnr(),java.nio.charset.StandardCharsets.UTF_8)%>">Back to Booking</a></div><% } %></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
