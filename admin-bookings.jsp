<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.text.SimpleDateFormat,com.lankawings.model.Booking,com.lankawings.util.HtmlUtil" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Booking Management | Lanka Wings</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container page-pad"><div class="page-title"><span class="eyebrow navy">ADMINISTRATOR</span><h1>Manage all bookings</h1><p>Review complete booking records, update passenger/reservation details, cancel bookings, and generate or download e-tickets.</p></div><% if(request.getParameter("ok")!=null){ %><div class="alert success">Booking record updated successfully.</div><% } if(request.getAttribute("error")!=null){ %><div class="alert error"><%=HtmlUtil.esc(String.valueOf(request.getAttribute("error")))%></div><% } List<Booking> bs=(List<Booking>)request.getAttribute("bookings");SimpleDateFormat df=new SimpleDateFormat("dd MMM yyyy, HH:mm"); %><div class="table-wrap"><table><thead><tr><th>PNR</th><th>Passenger</th><th>Flight</th><th>Route / Departure</th><th>Seat</th><th>Status</th><th>Actions</th></tr></thead><tbody><% if(bs!=null){for(Booking b:bs){ %><tr><td><b><%=HtmlUtil.esc(b.getPnr())%></b><br><small><%=HtmlUtil.esc(b.getPassportNo())%></small></td><td><%=HtmlUtil.esc(b.getPassengerName())%></td><td><%=HtmlUtil.esc(b.getFlightNo())%></td><td><%=HtmlUtil.esc(b.getOrigin())%> → <%=HtmlUtil.esc(b.getDestination())%><br><small><%=df.format(b.getDepartureTime())%></small></td><td><%=HtmlUtil.esc(b.getSeatNumber())%></td><td><span class="badge <%= "CANCELLED".equals(b.getBookingStatus())?"bad":"good" %>"><%=b.getBookingStatus()%></span></td><td><details><summary>Edit</summary><form method="post" class="admin-edit"><input type="hidden" name="id" value="<%=b.getBookingId()%>"><input type="hidden" name="action" value="update"><input name="passengerName" value="<%=HtmlUtil.esc(b.getPassengerName())%>" required><input name="passportNo" value="<%=HtmlUtil.esc(b.getPassportNo())%>" required><input name="seatNumber" value="<%=HtmlUtil.esc(b.getSeatNumber())%>" required><button class="btn btn-navy small" <%= "CANCELLED".equals(b.getBookingStatus())?"disabled":"" %>>Save</button></form></details><div class="mini-actions"><a href="<%=cp%>/ticket?bookingId=<%=b.getBookingId()%>">Ticket</a><a href="<%=cp%>/ticket/download?bookingId=<%=b.getBookingId()%>">Download</a></div><% if(!"CANCELLED".equals(b.getBookingStatus())){ %><form method="post" onsubmit="return confirm('Cancel this booking?')"><input type="hidden" name="id" value="<%=b.getBookingId()%>"><input type="hidden" name="action" value="cancel"><button class="link-danger">Cancel</button></form><% } %></td></tr><% }} %></tbody></table></div></main><%@ include file="WEB-INF/jspf/footer.jspf" %></body></html>
